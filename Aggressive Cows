class Solution {
    public boolean isPossible(int[] arr, int k , int minAllowedDist){  //O(N)
        int cows = 1;
        int lastStallposition = arr[0];
        
        for(int i=1; i<arr.length; i++){
            if( arr[i] - lastStallposition >= minAllowedDist){
                cows++;
                lastStallposition = arr[i];
            }
            if(cows == k){
                return true;
            }
        }
        return false;
    }
    
    public int aggressiveCows(int[] arr, int k) {
        //1.sort the array
        Arrays.sort(arr); // O(NlogN)
        
        int n = arr.length;
        int start = 0;
        int end = arr[n-1] - arr[0];  // MaxVal - minVal;
        int ans = -1;
        
        while(start <= end){  //O(logRange * N)
            int mid = start + (end - start) / 2;
            if(isPossible(arr , k , mid)){ //right
                ans = mid;
                start = mid + 1;
            }else{
                end = mid - 1;
            }
        }
        return ans;
    }
}
